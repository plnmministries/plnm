# ---- plnm (public website) ----
# Same Neon connection string as the admin app: the site reads published content + photos directly.
DATABASE_URL=
# Same value as REVALIDATE_SECRET in the admin app, so Publish refreshes this site instantly
REVALIDATE_SECRET=
# Optional fallback if DATABASE_URL isn't set: the admin app's address (e.g. https://plnmadmin.onrender.com)
CONTENT_API_URL=

# ---- mobile app API (/api/app/*) ----
# Signs app login tokens. Long random string (`openssl rand -hex 32`). Required in production (no fallback);
# changing it signs every member out.
APP_JWT_SECRET=
# Lets the scheduler call /api/app/cron (header x-cron-secret). Same value as the CRON_SECRET secret on the
# Cloudflare Worker (scripts/cron-worker.js) or the cron-job.org job. Long random string.
CRON_SECRET=
# The church's YouTube channel id (UC...), used by the scheduler to find new "Daily Word" videos.
# Optional: without it the channel from the published site settings is used.
YOUTUBE_CHANNEL_ID=
# Sends "forgot password" codes through Resend (resend.com → API Keys). Free tier: 100 emails a day.
# Leave empty locally: the code is logged to the console and returned to the app instead.
RESEND_API_KEY=
# The sender; its domain must be verified in Resend (see README → App login).
MAIL_FROM="Paralokanestham Ministries <no-reply@paralokanestham.in>"
# Optional: Expo access token (expo.dev → Access tokens) to lock push sending to this account.
EXPO_ACCESS_TOKEN=

# ---- Cloudflare R2 (every uploaded file: profile pictures, check-in selfies, website images) ----
# Setup steps are in README.md → "Cloudflare R2". Leave all of these empty to keep using the database.
# Cloudflare dashboard → R2 Object Storage → the 32-character Account ID shown on the overview page
R2_ACCOUNT_ID=
# R2 → Manage R2 API Tokens → Create API token, permission "Object Read & Write" for the two buckets below
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public bucket (avatars/ and media/), reachable through the custom domain below
R2_BUCKET=plnm
# Private bucket for check-in selfies (attendance/). No public access; a lifecycle rule deletes objects
# under attendance/ after 15 days. If left empty, selfies go to R2_BUCKET and are reachable publicly.
R2_PRIVATE_BUCKET=plnm-private
# Custom domain connected to R2_BUCKET (no trailing slash)
R2_PUBLIC_URL=https://media.paralokanestham.in

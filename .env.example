# ---- plnm (public website) ----
# Same Neon connection string as the admin app: the site reads published content + photos directly.
DATABASE_URL=
# Same value as REVALIDATE_SECRET in the admin app, so Publish refreshes this site instantly
REVALIDATE_SECRET=
# Optional fallback if DATABASE_URL isn't set: the admin app's address (e.g. https://plnmadmin.onrender.com)
CONTENT_API_URL=

# ---- mobile app API (/api/app/*) ----
# Signs app login tokens. Long random string (`openssl rand -hex 32`).
APP_JWT_SECRET=
# Lets the scheduler (GitHub Actions) call /api/app/cron. Same value as the CRON_SECRET repository secret.
CRON_SECRET=
# Sends login codes by email, e.g. smtps://paralokanestham@gmail.com:APP_PASSWORD@smtp.gmail.com:465
# (Gmail: Google Account → Security → 2-Step Verification → App passwords). Any SMTP provider works.
SMTP_URL=
MAIL_FROM="Paralokanestham Ministries <paralokanestham@gmail.com>"
# Optional: Expo access token (expo.dev → Access tokens) to lock push sending to this account.
EXPO_ACCESS_TOKEN=
